---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import TilTags from '@components/TilTags.astro';

export interface Props {
	entry: CollectionEntry<'til'>;
	// Compact version for the homepage: smaller heading, content cut off after a few lines
	preview?: boolean;
}

const { entry, preview = false } = Astro.props;
const { Content } = await render(entry);

const date = entry.data.datePublished.toLocaleDateString('en-US', { dateStyle: 'long' });
const Heading = preview ? 'h3' : 'h2';
---

<article class:list={['til-entry', { 'is-preview': preview }]}>
	<header>
		<Heading><a href={`/til/${entry.id}`}>{entry.data.title}</a></Heading>
		<div class="til-meta color-text-low-contrast">
			<time datetime={entry.data.datePublished.toISOString()}>{date}</time>
			<TilTags tags={entry.data.tags} />
		</div>
	</header>
	<div class="post-content til-content">
		<Content />
	</div>
	{
		entry.data.link && (
			<a class="til-link" href={entry.data.link}>
				{new URL(entry.data.link).hostname} ↗
			</a>
		)
	}
</article>

<style lang="css">
	.til-entry {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border-block-end: 1px solid var(--border-color-transparent);
		padding-block: 2rem;
	}

	h2,
	h3 {
		margin: 0;
		font-weight: 400;
		font-size: var(--font-size-large);

		a {
			text-decoration: none;
		}

		a:hover {
			text-decoration: underline;
		}
	}

	.til-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}

	.til-content :global(> :first-child) {
		margin-block-start: 0;
	}

	.til-content :global(> :last-child) {
		margin-block-end: 0;
	}

	.til-link {
		width: fit-content;
	}

	.is-preview {
		gap: 0.375rem;
		border-block-end: none;
		padding-block: 0 2rem;

		h3 {
			font-weight: 400;
			font-size: inherit;
			line-height: 1.21;

			a {
				text-decoration: underline;
			}
		}

		.til-meta {
			display: none;
		}

		.til-content {
			color: var(--text-color-low-contrast);
			line-height: 1.35;
			max-height: 6lh;
			overflow: hidden;
		}

		.til-content.is-clamped {
			mask-image: linear-gradient(to bottom, black 55%, transparent);
		}
	}
</style>

<script>
	// Only fade out previews that are actually cut off
	document.querySelectorAll('.til-entry.is-preview .til-content').forEach((el) => {
		el.classList.toggle('is-clamped', el.scrollHeight > el.clientHeight + 1);
	});
</script>
