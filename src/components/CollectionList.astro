---
import type { CollectionEntry } from 'astro:content';

export interface Props {
	title?: string;
	entries: CollectionEntry<'projects' | 'articles' | 'work'>[];
	id?: string;
}

const { title, entries, id } = Astro.props;

const sortedEntries = entries.sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime());

function allSameValue(keyName: string, arr: any[]): boolean {
	const values = arr.map((obj) => obj[keyName]);
	return new Set(values).size === 1;
}

const shouldLinkTitle = title && allSameValue('collection', sortedEntries);
const titleLink = shouldLinkTitle ? `/${sortedEntries[0].collection}` : null;
---

{
	sortedEntries.length > 0 && (
		<div class="post-list">
			{title && (
				<h2 class="color-text-low-contrast" id={id}>
					{titleLink ? <a href={titleLink}>{title}</a> : title}
				</h2>
			)}

			<slot />

			<div class="post-list--scroll">
				<table>
					<colgroup>
						<col class="col-title" />
						<col class="col-date" />
						<col class="col-tags" />
					</colgroup>
					<thead>
						<tr>
							<th scope="col">Title</th>
							<th scope="col">Date</th>
							<th scope="col">Tags</th>
						</tr>
					</thead>
					<tbody>
						{sortedEntries.map((entry) => (
							<tr>
								<td>
									<a href={`/${entry.collection}/${entry.id}`} aria-label={entry.data.description}>
										{entry.data.title}
									</a>
								</td>
								<td class="color-text-low-contrast">
									{entry.data.datePublished.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
									})}
								</td>
								<td class="color-text-low-contrast">{entry.data.tags.filter(Boolean).join(', ')}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	)
}

<style is:global>
	.insert-text + .post-list {
		margin-block-start: 2rem;
	}
</style>

<style lang="css">
	h2 {
		margin: 0.3rem 0;
		font-size: inherit;

		a {
			text-decoration: revert;
		}
	}

	.post-list--scroll {
		overflow-x: auto;
	}

	table {
		border-collapse: collapse;
		width: 100%;
		table-layout: fixed;
		white-space: nowrap;
	}

	.col-title {
		width: 50ch;
	}

	.col-date {
		width: 160px;
	}

	.col-tags {
		/* width: 50%; */
	}

	thead {
		display: none;
	}

	th,
	td {
		border: none;
		border-block-end: 1px solid var(--border-color-transparent);
		padding: 0.4rem 1.4rem 0.4rem 0rem;
		overflow: hidden;
		font-weight: 400;
		text-align: left;
		text-overflow: ellipsis;
	}

	th:last-child,
	td:last-child {
		padding-inline-end: 0;
	}

	th {
		color: var(--text-color-low-contrast);
		/* font-size: var(--font-size-small); */
	}

	td:nth-of-type(2) {
		text-align: right;
	}

	td a {
		text-decoration: none;
	}

	td a:hover {
		text-decoration: underline;
	}

	@media (pointer: coarse) {
		td a {
			display: inline-block;
			padding-block: 0.125rem;
		}
	}
</style>
