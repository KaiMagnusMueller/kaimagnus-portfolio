---
import type { CollectionEntry } from 'astro:content';

export interface Props {
	entries: CollectionEntry<'projects' | 'articles' | 'work' | 'til'>[];
}

const { entries } = Astro.props;

const sortedEntries = entries.sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime());
---

{
	sortedEntries.length > 0 && (
		<ul class="post-list">
			{sortedEntries.map((entry) => (
				<li>
					<a href={`/${entry.collection}/${entry.id}`} aria-label={entry.data.description || entry.data.title}>
						{entry.data.title}
					</a>
				</li>
			))}
		</ul>
	)
}

<style lang="css">
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		color: var(--text-color);
		text-decoration: underline;
		text-decoration-color: var(--text-color-lowest-contrast);
		text-underline-offset: 0.15em;

		&:hover {
			text-decoration-color: currentColor;
		}
	}
</style>
