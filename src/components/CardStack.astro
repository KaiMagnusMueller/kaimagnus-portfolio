---
import type { CollectionEntry } from 'astro:content';
import { getCardImage } from '@utils/getCardImage';

export interface Props {
	entries: CollectionEntry<'projects' | 'articles' | 'work'>[];
}
const { entries } = Astro.props;

const cards = entries
	.map((entry) => ({ entry, image: getCardImage(entry) }))
	.filter((card) => card.image);

const random = (min: number, max: number) => min + Math.random() * (max - min);

const hand = cards.map((card) => ({
	...card,
	jitter: random(-4, 4).toFixed(1),
	r: random(-4, 4).toFixed(2),
}));
---

<script is:inline>
	// Runs before the pile is parsed and decides whether the cards fly in or are simply in
	// place. They only fly in when the page opens at the top for a fresh visit: arriving
	// from elsewhere, or reloading while at the top.
	try {
		const type = performance.getEntriesByType('navigation')[0]?.type;
		const fromSite = document.referrer && new URL(document.referrer).origin === location.origin;

		// console.log({ type, fromSite });
		// Where the page was scrolled to when it was last left. The browser restores that
		// position on reload, but only after this script has run, so it's saved on the way out.
		const lastScroll = Number(sessionStorage.getItem('home-scroll')) || 0;
		addEventListener('pagehide', () => sessionStorage.setItem('home-scroll', String(scrollY)));

		const skip =
			type === 'back_forward' || // back/forward: referrer is the old one, so check the type
			location.hash !== '' || // jumps to a section, the pile is out of view
			(type === 'reload' ? lastScroll > 0 : fromSite); // reload mid-page, or a link on this site
		if (skip) document.documentElement.classList.add('cards-dealt');
	} catch {}
</script>

<aside class="card-stack">
	<div class="pile">
		{
			hand.map(({ entry, image, jitter, r }) => (
				<a
					class="stack-card"
					href={`/${entry.collection}/${entry.id}`}
					style={`--jitter: ${jitter}%; --r: ${r}deg`}
				>
					<img src={image} alt={entry.data.title} width="280" height="220" decoding="async" />
				</a>
			))
		}
	</div>
</aside>

<style lang="css">
	/* Built mobile first: a tall, centered zigzag pile, then a wrapping row of cards on
	   tablets, then the tilted pile on the right of the first screen on desktop. */

	/* Mobile: a section of its own below the hero, in the normal flow. Cards near the edges
	   may stick out of the pile, so the box reaches the screen edges and clips there, so they
	   can't make the page scroll sideways. Only sideways: the cards fly in from below. */
	.card-stack {
		margin-block-start: 4rem;
		margin-inline: calc(-1 * var(--page-gutter));
		padding-inline: var(--page-gutter);
		overflow-x: clip;
	}

	/* Most of the screen's height, but never too short, for phones held sideways */
	.pile {
		container-type: size;
		position: relative;
		margin-inline: auto;
		max-width: 25rem;
		height: 80svh;
		max-height: 580px;
	}

	.stack-card {
		position: absolute;
		--card-width: min(13rem, 55vw);
		/* Each card a little bigger than the one before */
		--scale: calc(1 + 0.05 * sibling-index());
		/* The deal-in starts from the middle of the pile */
		--deal-x: -50%;

		/* Divide the vertical space evenly among the cards */
		--t: calc(sibling-index() / (sibling-count() + 1));
		top: calc(var(--t) * 100%);

		/* Centered zigzag that opens up towards the bottom. Desktop adds the diagonal. */
		--start: 50%;
		--step: 0%;
		--amp: 12%;
		--amp-growth: 4%;
		/* 0-based index */
		--i: calc(sibling-index() - 1);
		/* Alternate direction for each card (+1, -1, +1, -1, …) */
		--dir: calc(2 * mod(sibling-index(), 2) - 1);

		/*
			Start												var(--start) -
			Decrease with each card								var(--i) * var(--step) +
			Swing left and right with increasing amplitude		var(--dir) * (var(--amp) + var(--i) * var(--amp-growth)) +
			Random component									var(--jitter, 0%)
		*/
		left: calc(
			var(--start) -
			var(--i) * var(--step) +
			var(--dir) * (var(--amp) + var(--i) * var(--amp-growth)) +
			var(--jitter, 0%)
		);

		translate: -50% -50%;
		rotate: var(--r);
		scale: var(--scale);
		transition: scale 0.25s ease;
		animation: deal-cards 0.9s cubic-bezier(0.2, 0.9, 0.3, 1) backwards
			calc(0.2s + sibling-index() * 0.12s);
		box-shadow: 0 0 8px 0 rgba(0, 0, 0, 0.2);
		border: 4px solid var(--text-color);
		border-radius: 8px;
		background: #fff;
		aspect-ratio: 28 / 22;
		width: var(--card-width);
		overflow: hidden;

		img {
			display: block;
			border-radius: 4px;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		&:focus-visible {
			z-index: 1;
			scale: calc(var(--scale) * 1.06);
		}

		@media (hover: hover) {
			&:hover {
				z-index: 1;
				scale: calc(var(--scale) * 1.06);
			}
		}
	}

	/* Tablet: the cards leave their positions and wrap in rows, left aligned with the text,
	   keeping only their random tilt */
	/* @media (min-width: 769px) {
		.pile {
			container-type: normal;
			display: flex;
			flex-wrap: wrap;
			gap: 1rem;
			margin-inline: 0;
			padding-block: 1rem;
			max-width: none;
			height: auto;
			max-height: unset;
		}

		.stack-card {
			position: static;
			--card-width: 13rem;
			--scale: 1;
			--deal-x: 0;

			translate: none;
		}
	} */

	/* Desktop: the pile sits on the right of the first screen and scrolls with the page.
	   Expects --page-top and --page-gutter from the page. It mirrors the page's margins: the
	   gutter separates it from the text column and sits to its right. */
	@media (min-width: 769px) {
		.card-stack {
			/* How much of the layout is kept: 1 from 1300px wide, shrinking linearly down to 0.4
			   at 1024px, where the pile is squeezed in next to the text. Dividing two lengths
			   gives a plain number, which scales the zigzag below and moves the pile's left edge. */
			--spread: clamp(0.4, (100vw - 1024px) / 276px, 1);

			position: absolute;
			inset-block-start: var(--page-top);
			/* The narrower the screen, the further right the pile starts, away from the hero text */
			/* inset-inline: calc(20rem + var(--page-gutter) + (1 - var(--spread)) * 10rem) 0; */
			/* height: calc(100svh - 2 * var(--page-top)); */
			inset-inline-end: var(--page-gutter);
			/* aspect-ratio: 4 / 6; */
			right: 0;
			margin: 0;
			padding: 0;
			width: 55%;
			height: 80vw;
			max-height: 960px;
			overflow: visible;
			z-index: 1;
		}

		.pile {
		/* container-type: size;
		position: relative;
		margin-inline: auto;
		max-width: 25rem;
		height: 80svh;
		max-height: 580px;

					container-type: normal;
			display: flex;
			flex-wrap: wrap;
			gap: 1rem;
			margin-inline: 0;
			padding-block: 1rem;
			max-width: none;
			height: auto;
			max-height: unset; */


			container-type: size;
			display: block;
			padding: 0;
			margin: 0;
			height: 100%;
			max-width: none;
			max-height: unset;

		}

		/* Back to the mobile positioning, now running diagonally down to the left */
		.stack-card {
			position: absolute;
			--card-width: min(230px, 16vw);
			--scale: calc(1 + 0.05 * sibling-index());
			--deal-x: -50%;

			--start: 75%;
			--step: 8%;
			--amp: 14%;
			--amp-growth: 3%;

			rotate: calc(var(--r) * 2);
			translate: -50% -50%;
		}
	}

	/* Only the start is given, the end is the card's own resting position. `left` only
	   matters where the cards are positioned. */
	@keyframes deal-cards {
		from {
			left: 50%;
			translate: var(--deal-x, 0) 100vh;
			rotate: 0deg;
			opacity: 0;
		}
	}

	@keyframes fade {
		from {
			opacity: 0;
		}
	}

	/* Coming back (see the script above): the cards are simply in place */
	:global(.cards-dealt) .stack-card {
		animation: none;
	}

	/* The cards are in place from the start and only fade in, one after another */
	@media (prefers-reduced-motion: reduce) {
		.stack-card {
			animation: fade 0.6s ease backwards calc(0.2s + var(--i) * 0.12s);
		}
	}

	/* @media (prefers-color-scheme: dark) {
		.stack-card {
			filter: brightness(0.95);
		}
	} */
</style>
