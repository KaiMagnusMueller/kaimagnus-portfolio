---
import { ColorPlayground } from '@utils/ColorPlayground';
import NodeCard from './NodeCard.astro';

interface Props {
	playground: ColorPlayground;
}

const { playground } = Astro.props;

const nodes = playground.getAllNodes();
const summary = playground.getSummary();
---

<div class="playground-viewer" id="playground-viewer">
	<div class="toolbar">
		<div class="toolbar-section">
			<h3>Add Node</h3>
			<div class="button-group">
				<button data-action="add-node" data-type="integer">Number</button>
				<button data-action="add-node" data-type="hue">Hue</button>
				<button data-action="add-node" data-type="chroma">Chroma</button>
				<button data-action="add-node" data-type="luminance">Luminance</button>
			</div>
			<div class="button-group">
				<button data-action="add-node" data-type="curve">Curve</button>
				<button data-action="add-node" data-type="linear">Linear</button>
				<button data-action="add-node" data-type="scale">Scale</button>
			</div>
		</div>

		<div class="toolbar-section">
			<h3>Playground Info</h3>
			<div class="info-grid">
				<div>Nodes: <span id="node-count">{summary.nodeCount}</span></div>
				<div>Connections: <span id="connection-count">{summary.connectionCount}</span></div>
			</div>
		</div>
	</div>

	<div class="nodes-grid" id="nodes-grid">
		{
			nodes.length === 0 ? (
				<div class="empty-state">No nodes yet. Add one to get started!</div>
			) : (
				nodes.map((node) => <NodeCard node={node} />)
			)
		}
	</div>
</div>

<script>
	import { ColorPlayground } from '@utils/ColorPlayground';
	import type { ColorNode } from '@utils/colorNodes';
	import { getNodeMetadata } from '@utils/nodeUIMetadata';

	let playground: ColorPlayground;

	// Update stats only
	function refreshStats() {
		const summary = playground.getSummary();
		const nodeCount = document.getElementById('node-count');
		const connCount = document.getElementById('connection-count');
		if (nodeCount) nodeCount.textContent = summary.nodeCount.toString();
		if (connCount) connCount.textContent = summary.connectionCount.toString();
	}

	// Event delegation for toolbar
	function handleClick(e: MouseEvent) {
		const target = e.target as HTMLElement;
		const action = target.dataset.action || target.closest('[data-action]')?.getAttribute('data-action');

		if (action === 'add-node') {
			const type = target.dataset.type || target.closest('[data-type]')?.getAttribute('data-type');
			if (type) {
				const node = playground.createNode(type);
				if (node) {
					// Create and append new node card dynamically
					addNodeCardToDOM(node);
					refreshStats();
				}
			}
		}
	}

	// Dynamically add a node card to the DOM
	function addNodeCardToDOM(node: ColorNode) {
		const grid = document.getElementById('nodes-grid');
		if (!grid) return;

		// Remove empty state if it exists
		const emptyState = grid.querySelector('.empty-state');
		if (emptyState) {
			emptyState.remove();
		}

		// Get node metadata for styling
		const metadata = getNodeMetadata(node.type);
		const nodeColor = metadata?.color || '#666';

		// Determine which sections to show based on node type
		const showInputs = !['integer', 'hue', 'chroma', 'luminance'].includes(node.type);
		const showOutputs = node.type !== 'scale';
		const showColorPreview = node.type === 'scale';

		// Create the node card HTML
		const nodeCardHTML = `
			<div class="node-card base-node" style="--node-color: ${nodeColor}" data-node-id="${node.id}">
				<div class="node-header">
					<div class="node-type">${metadata?.displayName || node.type}</div>
					<button class="delete-btn" data-action="delete-node" title="Delete Node">×</button>
				</div>

				<div class="node-name-container">
					<input class="node-name-input" type="text" value="${node.name}" data-field="name" placeholder="Node name" />
				</div>

				${metadata?.description ? `<div class="node-description">${metadata.description}</div>` : ''}

				${
					showInputs
						? `
					<div class="connections-section inputs" data-section="inputs">
						<div class="section-label">Inputs</div>
						<div class="connections-list" data-connections-type="inputs">
							<div class="no-connections">No inputs</div>
						</div>
					</div>
				`
						: ''
				}

				<div class="fields-section" data-section="fields">
					<!-- Will be populated by controller -->
				</div>

				${
					showColorPreview
						? `
					<div class="color-preview-section" data-section="color-preview">
						<div class="section-label">Colors</div>
						<div class="color-preview">
							<div class="no-colors">Configure inputs to generate colors</div>
						</div>
					</div>
				`
						: ''
				}

				${
					showOutputs
						? `
					<div class="connections-section outputs" data-section="outputs">
						<div class="section-label">Outputs</div>
						<div class="connections-list" data-connections-type="outputs">
							<div class="no-connections">No outputs</div>
						</div>
					</div>
				`
						: ''
				}
			</div>
		`;

		// Add to grid
		const tempDiv = document.createElement('div');
		tempDiv.innerHTML = nodeCardHTML.trim();
		const nodeElement = tempDiv.firstElementChild as HTMLElement;
		grid.appendChild(nodeElement);

		// Initialize the appropriate controller
		initializeNodeCard(nodeElement, node.type);
	}

	// Initialize a node card with the appropriate controller
	function initializeNodeCard(element: HTMLElement, nodeType: string) {
		// Trigger the node card initialization event
		// The individual node card scripts will pick this up
		const event = new CustomEvent('node-card-added', {
			detail: { element, nodeType },
		});
		window.dispatchEvent(event);
	}

	// Initialize playground
	function initialize() {
		playground = (window as any).__playground as ColorPlayground;

		if (!playground) {
			console.error('Playground not found on window');
			return;
		}

		// Listen to playground changes for stats and connection updates
		playground.onChange((event) => {
			console.log('Playground changed:', event);

			if (event.type === 'node-removed') {
				// Remove the node card from DOM
				const nodeCard = document.querySelector(`[data-node-id="${event.nodeId}"]`);
				if (nodeCard) {
					nodeCard.remove();
				}
				refreshStats();

				// Check if grid is empty
				const grid = document.getElementById('nodes-grid');
				if (grid && grid.children.length === 0) {
					grid.innerHTML = '<div class="empty-state">No nodes yet. Add one to get started!</div>';
				}
			} else if (event.type === 'connection-added' || event.type === 'connection-removed') {
				// Connections are handled by individual node cards
				refreshStats();
			}
		});

		// Event delegation for toolbar
		document.addEventListener('click', handleClick);

		// Initial render
		refreshStats();
	}

	// Wait for playground to be ready
	if ((window as any).__playground) {
		initialize();
	} else {
		window.addEventListener('playground-ready', initialize, { once: true });
	}
</script>

<style>
	.playground-viewer {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		height: 100%;
	}

	.toolbar {
		display: flex;
		gap: 2rem;
		border: 1px solid var(--border-color-transparent);
		border-radius: 8px;
		background: var(--card-bg-color);
		padding: 1rem;
	}

	.toolbar-section h3 {
		margin: 0 0 0.75rem;
		font-weight: 600;
		font-size: 0.9rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.button-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}

	.button-group button {
		transition: background 0.2s;
		cursor: pointer;
		border: none;
		border-radius: 4px;
		background: var(--color-primary, #3b82f6);
		padding: 0.5rem 1rem;
		color: white;
		font-size: 0.85rem;
	}

	.button-group button:hover {
		background: var(--color-primary-dark, #2563eb);
	}

	.info-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.5rem;
		font-size: 0.85rem;
	}

	.nodes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		flex: 1;
		gap: 1rem;
		padding: 0.5rem;
		overflow-y: auto;
	}

	.empty-state {
		grid-column: 1 / -1;
		padding: 2rem;
		color: var(--color-text-secondary, #666);
		font-style: italic;
		text-align: center;
	}
</style>
