---
import type { ColorNode } from '@utils/colorNodes';
import type { Connection } from '@utils/ColorPlayground';
import { getNodeMetadata, getFieldValue, formatBezierString } from '@utils/nodeUIMetadata';

interface Props {
	node: ColorNode;
	connections: { inputs: Connection[]; outputs: Connection[] };
}

const { node, connections } = Astro.props;
const metadata = getNodeMetadata(node.type);
const nodeColor = metadata?.color || '#666';
---

<div class="node-ui" style={`--node-color: ${nodeColor}`} data-node-id={node.id}>
	<div class="node-header">
		<div class="node-type">{metadata?.displayName || node.type}</div>
		<input class="node-name-input" type="text" value={node.name} data-field="name" placeholder="Node name" />
	</div>

	{metadata?.description && <div class="node-description">{metadata.description}</div>}

	<!-- Input Connections -->
	{
		connections.inputs.length > 0 && (
			<div class="connections-section">
				<div class="section-label">Inputs</div>
				{connections.inputs.map((conn) => (
					<div class="connection-item">
						<span class="connection-label">← {conn.sourceNodeId.slice(0, 8)}</span>
						<button
							class="disconnect-btn"
							data-connection-id={conn.id}
							data-action="disconnect"
							title="Disconnect">
							×
						</button>
					</div>
				))}
			</div>
		)
	}

	<!-- Fields -->
	{
		metadata?.fields && metadata.fields.length > 0 && (
			<div class="fields-section">
				{metadata.fields.map((field) => {
					const value = getFieldValue(node, field);
					const displayValue = field.inputType === 'bezier' ? formatBezierString(value) : value;

					return (
						<div class="field">
							<label class="field-label">
								{field.label}
								{field.unit && <span class="field-unit">{field.unit}</span>}
							</label>

							{field.inputType === 'number' && (
								<input
									type="number"
									value={displayValue}
									min={field.min}
									max={field.max}
									step={field.step || 1}
									disabled={field.readonly}
									data-field={field.key}
									class="field-input"
								/>
							)}

							{field.inputType === 'slider' && (
								<div class="slider-container">
									<input
										type="range"
										value={displayValue}
										min={field.min}
										max={field.max}
										step={field.step || 0.01}
										disabled={field.readonly}
										data-field={field.key}
										class="field-slider"
									/>
									<span class="slider-value">{Number(displayValue).toFixed(2)}</span>
								</div>
							)}

							{(field.inputType === 'text' || field.inputType === 'bezier') && (
								<input
									type="text"
									value={displayValue}
									disabled={field.readonly}
									data-field={field.key}
									class="field-input"
									placeholder={field.inputType === 'bezier' ? '0.25,0.5;0.75,0.5' : ''}
								/>
							)}

							{field.inputType === 'color-preview' && (
								<div class="color-preview">
									{displayValue && displayValue.length > 0 ? (
										<>
											<div class="color-strip">
												{displayValue.map((color: any) => (
													<div
														class="color-swatch"
														style={`background-color: ${color.toString({ format: 'hex' })}`}
														title={color.toString({ format: 'hex' })}
													/>
												))}
											</div>
											<div class="color-count">{displayValue.length} colors</div>
										</>
									) : (
										<div class="no-colors">No colors generated</div>
									)}
								</div>
							)}

							{field.inputType === 'readonly' && <div class="field-readonly">{displayValue}</div>}
						</div>
					);
				})}
			</div>
		)
	}

	<!-- Output Connections -->
	{
		connections.outputs.length > 0 && (
			<div class="connections-section">
				<div class="section-label">Outputs</div>
				{connections.outputs.map((conn) => (
					<div class="connection-item">
						<span class="connection-label">→ {conn.targetNodeId.slice(0, 8)}</span>
						<button
							class="disconnect-btn"
							data-connection-id={conn.id}
							data-action="disconnect"
							title="Disconnect">
							×
						</button>
					</div>
				))}
			</div>
		)
	}
</div>

<style>
	.node-ui {
		border: 2px solid var(--node-color);
		border-radius: 8px;
		background: var(--color-background, white);
		padding: 1rem;
		min-width: 250px;
		max-width: 350px;
	}

	.node-header {
		margin-bottom: 0.75rem;
	}

	.node-type {
		margin-bottom: 0.25rem;
		color: var(--node-color);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.node-name-input {
		border: 1px solid var(--color-border, #ddd);
		border-radius: 4px;
		background: transparent;
		padding: 0.25rem 0.5rem;
		width: 100%;
		font-size: 0.9rem;
	}

	.node-description {
		margin-bottom: 0.75rem;
		color: var(--color-text-secondary, #666);
		font-size: 0.8rem;
		line-height: 1.4;
	}

	.connections-section {
		margin: 0.75rem 0;
		border-radius: 4px;
		background: var(--color-surface, #f9f9f9);
		padding: 0.5rem;
	}

	.section-label {
		margin-bottom: 0.5rem;
		color: var(--color-text-secondary, #666);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.connection-item {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.25rem 0;
		font-size: 0.85rem;
	}

	.connection-label {
		color: var(--color-text, #333);
		font-family: monospace;
	}

	.disconnect-btn {
		display: flex;
		justify-content: center;
		align-items: center;
		transition: background 0.2s;
		cursor: pointer;
		border: none;
		border-radius: 50%;
		background: var(--color-error, #ef4444);
		padding: 0;
		width: 20px;
		height: 20px;
		color: white;
		font-size: 1rem;
		line-height: 1;
	}

	.disconnect-btn:hover {
		background: var(--color-error-dark, #dc2626);
	}

	.fields-section {
		margin: 0.75rem 0;
	}

	.field {
		margin-bottom: 0.75rem;
	}

	.field:last-child {
		margin-bottom: 0;
	}

	.field-label {
		display: block;
		margin-bottom: 0.25rem;
		color: var(--color-text, #333);
		font-weight: 500;
		font-size: 0.85rem;
	}

	.field-unit {
		margin-left: 0.25rem;
		color: var(--color-text-secondary, #666);
		font-weight: 400;
	}

	.field-input {
		border: 1px solid var(--color-border, #ddd);
		border-radius: 4px;
		padding: 0.375rem 0.5rem;
		width: 100%;
		font-size: 0.9rem;
	}

	.slider-container {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.field-slider {
		flex: 1;
	}

	.slider-value {
		min-width: 4ch;
		font-size: 0.85rem;
		font-family: monospace;
		text-align: right;
	}

	.field-readonly {
		border-radius: 4px;
		background: var(--color-surface, #f9f9f9);
		padding: 0.375rem 0.5rem;
		color: var(--color-text-secondary, #666);
		font-size: 0.9rem;
	}

	.color-preview {
		margin-top: 0.25rem;
	}

	.color-strip {
		display: flex;
		gap: 2px;
		margin-bottom: 0.25rem;
		border-radius: 4px;
		height: 40px;
		overflow: hidden;
	}

	.color-swatch {
		flex: 1;
		transition: transform 0.2s;
		cursor: pointer;
	}

	.color-swatch:hover {
		transform: scale(1.05);
		z-index: 1;
	}

	.color-count {
		color: var(--color-text-secondary, #666);
		font-size: 0.8rem;
		text-align: center;
	}

	.no-colors {
		padding: 1rem;
		color: var(--color-text-secondary, #666);
		font-style: italic;
		font-size: 0.85rem;
		text-align: center;
	}
</style>
