---
import { SITE } from '@config';
import Navigation from '@components/Navigation.astro';
import FullScreenLayout from '../../layouts/FullScreenLayout.astro';
import PlaygroundViewer from '@components/PlaygroundViewer.astro';
import {
	createSimpleLinearScale,
	createCurvedScale,
	createReactiveScale,
	createMultipleScalesFromSharedSource,
	demonstrateCaching,
	createMixedInterpolationScale,
} from '@utils/colorExamples';
import { createBasicPlayground, createCurvedPlayground } from '@utils/ColorPlayground';

let pageTitle = 'Colors';

const breadcrumbs = [{ href: '/', label: 'Kai Magnus' }, { label: pageTitle }];

// Example 1: Simple linear scale
const example1 = createSimpleLinearScale();
console.log('Example 1 - Simple Linear Scale:', {
	colorCount: example1.colors.length,
	firstColor: example1.colors[0]?.toString({ format: 'hex' }),
	lastColor: example1.colors[example1.colors.length - 1]?.toString({ format: 'hex' }),
});

// Example 2: Curved scale
const example2 = createCurvedScale();
console.log('Example 2 - Curved Scale:', {
	colorCount: example2.colors.length,
	steps: example2.nodes.steps.getValue(),
	hueRange: example2.nodes.hue.getRange(),
});

// Example 3: Reactive updates
const example3 = createReactiveScale();
console.log('Example 3 - Reactive Updates:', {
	totalUpdates: example3.updateCount,
	updates: example3.updates,
	finalColorCount: example3.currentColors.length,
});

// Example 4: Shared sources
const example4 = createMultipleScalesFromSharedSource();
console.log('Example 4 - Shared Sources:', {
	blueScaleColors: example4.blueColors.length,
	redScaleColors: example4.redColors.length,
	sharedSteps: example4.nodes.steps.getValue(),
});

// Example 5: Caching performance
const example5 = demonstrateCaching();
console.log('Example 5 - Caching Performance:', {
	firstCallMs: example5.firstCallTime.toFixed(3),
	cachedCallMs: example5.cachedCallTime.toFixed(3),
	speedup: `${example5.speedupFactor.toFixed(0)}x faster`,
	cacheWorks: example5.areSame,
});

// Example 6: Mixed interpolation
const example6 = createMixedInterpolationScale();
console.log('Example 6 - Mixed Interpolation:', {
	colorCount: example6.colors.length,
	colors: example6.colors.map((c) => c.toString({ format: 'hex' })),
});

// Format colors for display
const formatColorScale = (colors: any[]) => {
	return colors.map((color, i) => ({
		index: i,
		hex: color.toString({ format: 'hex' }),
		oklch: `L:${(color.oklch.l * 100).toFixed(1)} C:${color.oklch.c.toFixed(3)} H:${color.oklch.h.toFixed(1)}`,
	}));
};

const displayScales = {
	simple: formatColorScale(example1.colors),
	curved: formatColorScale(example2.colors),
	reactive: formatColorScale(example3.currentColors),
	blue: formatColorScale(example4.blueColors),
	red: formatColorScale(example4.redColors),
	mixed: formatColorScale(example6.colors),
};

// Create an interactive playground
const playground = createBasicPlayground();
---

<FullScreenLayout
	pageTitle={'Parametric color scales' + ' from ' + SITE.titleShort}
	pageDescr={'Interactive color scale experiment'}>
	<div slot="navigation">
		<Navigation {breadcrumbs} />

		<div class="fullscreen-header">
			<h1 class="text-huge color-text">{pageTitle}</h1>
			<p>Node-based color scale generator using OKLCH color space</p>
		</div>
	</div>
	<div class="fullscreen-content">
		<section class="playground-section">
			<h2>Interactive Node Playground</h2>
			<PlaygroundViewer playground={playground} />
