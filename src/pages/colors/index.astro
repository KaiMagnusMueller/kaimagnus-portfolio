---
import { SITE } from '@config';
import Navigation from '@components/Navigation.astro';
import FullScreenLayout from '../../layouts/FullScreenLayout.astro';
import PlaygroundViewer from '@components/PlaygroundViewer.svelte';

let pageTitle = 'Colors';

const breadcrumbs = [{ href: '/', label: 'Kai Magnus' }, { label: pageTitle }];
---

<FullScreenLayout
	pageTitle={'Parametric color scales' + ' from ' + SITE.titleShort}
	pageDescr={'Interactive color scale experiment'}>
	<div slot="navigation">
		<Navigation {breadcrumbs} />

		<div class="fullscreen-header">
			<h1 class="text-huge color-text">{pageTitle}</h1>
			<p>Node-based color scale generator using OKLCH color space</p>
		</div>
	</div>
	<div class="fullscreen-content">
		<PlaygroundViewer client:load />
	</div>
</FullScreenLayout>

<style lang="css">
	.playground-section {
		margin-bottom: 2rem;
		border-bottom: 2px solid var(--color-border);
		padding: 2rem;
		min-height: 600px;
	}

	.playground-section h2 {
		margin: 0 0 1.5rem;
		font-weight: 600;
		font-size: 1.5rem;
	}
</style>

<script>
	import { createBasicPlayground, ColorPlayground } from '../../utils/ColorPlayground.svelte';

	const STORAGE_KEY = 'color-playground-state';

	// Create playground on client-side to preserve methods
	let playground: ColorPlayground;

	playground = createBasicPlayground();

	(window as any).__playground = playground;

	// Trigger initial render
	window.dispatchEvent(new CustomEvent('playground-ready'));
</script>
