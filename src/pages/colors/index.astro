<style lang="css">
	.playground-section {
		margin-bottom: 2rem;
		border-bottom: 2px solid var(--color-border);
		padding: 2rem;
		min-height: 600px;
	}

	.playground-section h2 {
		margin: 0 0 1.5rem;
		font-weight: 600;
		font-size: 1.5rem;
	}

	.examples-grid {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		padding: 2rem;
	}

	.example {
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-background);
		padding: 1.5rem;
	}

	.example h2 {
		margin: 0 0 1rem;
		font-weight: 600;
		font-size: 1.25rem;
	}

	.color-strip {
		display: flex;
		gap: 4px;
		margin-bottom: 1rem;
		height: 60px;
	}

	.color-swatch {
		flex: 1;
		transition: transform 0.2s;
		cursor: pointer;
		border-radius: 4px;
	}

	.color-swatch:hover {
		transform: scale(1.05);
	}

	.example-info,
	.performance-info {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 0.9rem;
		line-height: 1.6;
	}
</style>

<script>
	import { createBasicPlayground } from '@utils/ColorPlayground';

	// Create playground on client-side to preserve methods
	const playground = createBasicPlayground();
	(window as any).__playground = playground;

	// Trigger initial render
	window.dispatchEvent(new CustomEvent('playground-ready'));
</script>
