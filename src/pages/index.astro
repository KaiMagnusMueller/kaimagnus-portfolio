---
import { SITE } from '@config';

import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CardStack from '@components/CardStack.astro';
import CollectionList from '@components/CollectionList.astro';
import HomeSection from '@components/HomeSection.astro';
import TilEntry from '@components/TilEntry.astro';
import { getTils } from '@utils/getTils';

const articles = await getCollection('articles', ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});

const universityProjects = await getCollection('projects', ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});
const work = await getCollection('work', ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});

const latestTils = (await getTils()).slice(0, 6);

// Cards for the pile next to the content: everything marked as noteworthy
const noteworthy = [...work, ...universityProjects, ...articles]
	.filter((entry) => entry.data.featured.includes('noteworthy'))
	.sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime());

// Handpicked, in this order. Not tied to the work collection, since some of these
// (Sopea, Collections) don't have a case study yet.
const handpickedWork = [
	{
		title: 'Sopea HR',
		href: 'https://www.sopea.com/',
		description:
			'I drive design, strategy and growth for a suite of HR products and use my coding skills to develop prototypes and collaborate with developers.',
	},
	{
		title: 'Collections',
		description:
			'In my spare time, I develop a bookmarking tool that traces its origins back to Halo, a project I did back in university. It is built in SvelteKit and my personal space for experimentation.',
	},
	{
		title: 'Allianz',
		href: '/work/epic-designing-internal-applications',
		description:
			'EPIC is an application for investment managers. I led design and supported the developer team until its rollout.',
	},
];

---

<Layout pageTitle={SITE.title} pageDescr={SITE.desc}>
	<Fragment slot="head">
		<link rel="preload" href="/200-20-5-monochrome.png" as="image" />
		<link rel="dns-prefetch" href="https://cdn.kaimagnus.de" />
		<link rel="dns-prefetch" href="https://res.cloudinary.com" />
	</Fragment>

	<main class="index-page color-text">
		<div class="hero--section text">
			<p>
				<span class="highlight--default">Hi, I'm <a href="/about">Kai Magnus</a></span>, a <span
					class="highlight--job">product designer</span
				> and <span class="highlight--job">developer</span> who specializes in <span
					class="highlight--skill">complex systems</span
				> and <span class="highlight--skill">tools for experts</span>.
			</p>
			<p
				>At <a href="https://www.sopea.com/" class="highlight--default">Sopea</a> I drive <span
					class="highlight--skill">design, strategy and growth</span
				> for a suite of HR products and use my coding skills to <span class="highlight--skill"
					>develop prototypes</span
				> and collaborate with developers.</p
			>
			<p
				>I also <span class="highlight--job">teach</span> Interaction Design at <a
					href="https://www.hfg-gmuend.de/"
					class="highlight--default">HfG Schwäbisch Gmünd</a
				> and led design for insurance and investment applications and <span class="highlight--skill"
					>design systems</span
				>
					at <a href="https://www.kaiser-x.com" class="highlight--default">Allianz</a>.</p
				>
		</div>

		<CardStack entries={noteworthy} />

		<HomeSection id="work" title="Work" href="/work">
			<ul class="work-list">
				{
					handpickedWork.map((item) => (
						<li>
							<h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
							<p class="color-text-low-contrast">{item.description}</p>
						</li>
					))
				}
			</ul>
		</HomeSection>

		<HomeSection id="posts" title="Posts" href="/articles">
			<CollectionList entries={articles} />
		</HomeSection>

		{
			latestTils.length > 0 && (
				<HomeSection id="til" title="TIL" href="/til">
					{latestTils.map((entry) => (
						<TilEntry {entry} preview />
					))}
				</HomeSection>
			)
		}

		<ul class="misc-list">
			<li><a href="/projects">University Projects</a></li>
		</ul>
	</main>

	<style lang="css">
		/* --page-top is also read by CardStack, which positions itself against this container */
		.index-page {
			--page-top: clamp(4rem, 13vh, 8rem);

			position: relative;
			padding-block-start: var(--page-top);
		}

		.hero--section {
			/* Can run under the pile a little */
			max-width: 40.5rem;
			color: var(--text-color-lowest-contrast);
			font-size: var(--font-size-large);
			line-height: 1.3;

			p {
				margin-block: 0 0.43em;
			}

			a {
				text-decoration: none;
			}
		}

		.highlight--default {
			color: var(--text-color);
		}

		/* Hovering a word brings out the others of its kind and fades the names */
		.hero--section:has(.highlight--job:hover) .highlight--job,
		.hero--section:has(.highlight--skill:hover) .highlight--skill {
			color: var(--text-color);
		}

		.hero--section:has(.highlight--job:hover) .highlight--default,
		.hero--section:has(.highlight--skill:hover) .highlight--default {
			color: var(--text-color-lowest-contrast);
		}

		.highlight--default,
		.highlight--job,
		.highlight--skill {
			transition: color 0.3s ease;
		}

		.work-list {
			display: flex;
			flex-direction: column;
			gap: 1.75rem;
			margin: 0;
			padding: 0;
			list-style: none;

			h3 {
				margin: 0 0 0.375rem;
				font-weight: 510;
				font-size: var(--font-size-medium);
				line-height: 1.21;

				a {
					text-decoration: underline;
					text-underline-offset: 0.15em;
				}
			}

			p {
				margin: 0;
				line-height: 1.35;
			}
		}

		.misc-list {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			margin: 6rem 0 0;
			padding: 0;
			max-width: 25rem;
			list-style: none;

			a {
				text-decoration: underline;
			}
		}

		@media (max-width: 768px) {
			.index-page {
				--page-top: clamp(4rem, 10vh, 8rem);
			}

			.misc-list {
				margin-block-start: 4rem;
			}
		}
	</style>
</Layout>
