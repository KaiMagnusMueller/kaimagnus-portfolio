---
import { SITE, COLLECTIONS } from '@config';

import Layout from '../../layouts/Layout.astro';
import PostList from '../../layouts/PostList.astro';
---

<Layout
	pageTitle={COLLECTIONS.articles.title + ' from ' + SITE.titleShort}
	pageDescr={'Occasionally, I write about topics related to design, my work and other things.'}>
	<PostList collectionName={'articles'} />
</Layout>
